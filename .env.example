# ===========================================================================
#  SIH 26009 - consolidated environment reference
# ===========================================================================
#  This file is a REFERENCE ONLY - the three services read their own `.env`.
#  Copy the relevant section into the matching service directory:
#
#     backend/.env        <- section 1
#     ai-service/.env     <- section 2
#     frontend/.env       <- section 3
#
#  Quick start:
#     cd backend      && cp .env.example .env     # set JWT_SECRET + MONGODB_URI
#     cd ai-service   && cp .env.example .env
#     cd frontend     && cp .env.example .env
# ===========================================================================


# ===========================================================================
#  1. BACKEND  (backend/.env)
# ===========================================================================
# --- Database (REQUIRED) ---
# Local:  mongodb://127.0.0.1:27017/sih26009
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sih26009?retryWrites=true&w=majority
MONGODB_URI=

# --- JWT (REQUIRED) ---
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=sih26009-api
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Weather API (REQUIRED for the server to boot) ---
# Free key: https://home.openweathermap.org/api_keys
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Seeded administrator ---
# Created on first boot when no admin exists.
ADMIN_EMAIL=admin@moil.gov.in
# REQUIRED when NODE_ENV=production. In development it falls back to
# `Admin@12345` with a warning - change it.
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator

# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Where the Python ai-service is listening.
AI_SERVICE_URL=http://localhost:8000


# ===========================================================================
#  2. AI-SERVICE  (ai-service/.env)
# ===========================================================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Earth Engine (REQUIRED for Module A) ---
# Cloud project that owns the Earth Engine quota.
GEE_PROJECT=gen-lang-client-0167226131
# Optional: service account JSON path for CI / headless runs.
# GEE_SERVICE_ACCOUNT_KEYFILE=
#
# One-time local auth (per machine):
#   earthengine authenticate


# ===========================================================================
#  3. FRONTEND  (frontend/.env)
# ===========================================================================
# Only VITE_-prefixed variables reach the browser bundle.
# Leave empty in development to use the Vite dev proxy (/api -> :5000).
VITE_API_BASE_URL=
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics
