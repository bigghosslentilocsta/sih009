# ---------------------------------------------------------------------------
# SIH 26009 - frontend environment template
# Copy to `.env` and adjust:  cp .env.example .env
# Only VITE_-prefixed vars are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Backend API base URL. Left empty in dev to use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Google Earth Engine / map tiles exposed to the map view
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics
