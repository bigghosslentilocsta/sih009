# ---------------------------------------------------------------------------
# SIH 26009 - backend environment template
# Copy to `.env` and fill in your own values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/sih26009
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sih26009?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sih26009

# --- JWT / auth ---
# REQUIRED. Generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=sih26009-api
# bcrypt cost factor. 12 is a good default; lower it only for fast local tests.
BCRYPT_ROUNDS=12
# Brute-force protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Default administrator (seeded on first boot) ---
ADMIN_EMAIL=admin@moil.gov.in
# REQUIRED when NODE_ENV=production. In development it falls back to `Admin@12345`
# with a warning - set your own here so the first account is never predictable.
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator

# --- Weather API ---
# OpenWeatherMap: https://home.openweathermap.org/api_keys  (free tier available)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# --- AI service (Python/FastAPI) ---
AI_SERVICE_URL=http://localhost:8000

# --- CORS: comma separated list of allowed origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
