# ---------------------------------------------------------------------------
# SIH 26009 - ai-service environment template
# Copy to `.env` and adjust:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Service ---
ENVIRONMENT=development
DEBUG=true
APP_VERSION=0.1.0

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --- CORS: comma separated list of allowed origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Earth Engine ---
# Cloud project that owns the Earth Engine quota.
GEE_PROJECT=gen-lang-client-0167226131
# Optional: absolute path to a service account JSON for CI / headless runs.
# GEE_SERVICE_ACCOUNT_KEYFILE=
